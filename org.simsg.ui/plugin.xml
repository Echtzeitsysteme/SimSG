<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension-point id="SimSGModelBuilderExtension" name="SimSGModelBuilderExtension" schema="schema/SimSGModelBuilderExtension.exsd"/>
<extension id="org.simsg.ui.SimSGNature" name="SimSG Nature" point="org.eclipse.core.resources.natures">
        <runtime>
            <run class="org.simsg.ui.wizard.SimSGNature"/>
        </runtime>
    </extension>
    <extension point="org.eclipse.ui.ide.projectNatureImages">
        <image icon="icons/daten-und-ordner.png" id="org.simsg.ui.SimSGNatureImage" natureId="org.simsg.ui.SimSGNature"/>
</extension>
  <extension point="org.eclipse.ui.newWizards">
    <category id="org.simsg.ui.category" name="SimSG"/>
    <wizard
          category="org.simsg.ui.category"
          class="org.simsg.ui.wizard.NewSimSGProjectWizard"
          icon="icons/daten-und-ordner.png"
          id="org.simsg.ui.wizard.NewSimSGProjectWizard"
          name="New SimSG Project Wizard"
          project="true">
    </wizard>
  </extension>
  <extension
        point="org.emoflon.ibex.gt.GTDependingBuilderExtension">
     <builder_extension
           class="org.simsg.ui.build.SimSGBuilder">
     </builder_extension>
  </extension>
  <!--
  Property dialog contributsion
  -->
</plugin>
